# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it is excluded by .gitignore.

ibmcloud_api_key = "YOUR_IBM_CLOUD_API_KEY"
ssh_public_key   = "ssh-ed25519 AAAA... your-comment"
ssh_private_key  = <<-EOT
-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----
EOT

region         = "us-south"
zone           = "us-south-1"
resource_group = "Default"
instance_name  = "apm-demo"

# Ubuntu 24.04 LTS image ID for the target region.
# Find with: ibmcloud is images --visibility public --status available | grep ibm-ubuntu-24-04
image_id = "r006-867f36e5-f875-4571-9c60-b4ea9a0bc1b9"
